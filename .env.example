# Django
SECRET_KEY=django-insecure-change-this-in-production
DEBUG=True
DB_PATH=                        # Leave empty to use db.sqlite3 at project root

# MongoDB Atlas App Services (formerly Stitch)
# Get these from: MongoDB Atlas > App Services > your-app > Authentication
MONGODB_API_KEY=your-atlas-api-key-here
MONGODB_APP_ID=your-app-id-here        # e.g. wodzone-abcde
MONGODB_DATABASE=wodzone
MONGODB_COLLECTION=checkins
